LCL:
    VERSION: "0.3.0"

SPECIFICATION:
    ID: fixture.project
    NAME: "Duplicate part"
    VERSION: "1.0.0"
    KIND: kind.project

PART:
    ID: part.task
    SOURCE: PATH("task.lcl")
    KIND: kind.part.task

PART:
    ID: part.again
    SOURCE: PATH("./task.lcl")
    KIND: kind.part.task

EXECUTE:
    REFERENCE: REF(task.double)
