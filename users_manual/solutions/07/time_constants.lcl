LCL:
    VERSION: "0.1.0"

SPECIFICATION:
    ID: course.time_constants
    NAME: "Time constants"
    VERSION: "1.0.0"
    KIND: kind.data

DEFINE:
    ID: constant.days_per_week
    KIND: kind.constant
    TYPE: INTEGER
    VALUE: 7

DEFINE:
    ID: constant.hours_per_day
    KIND: kind.constant
    TYPE: INTEGER
    VALUE: 24

DEFINE:
    ID: constant.minutes_per_hour
    KIND: kind.constant
    TYPE: INTEGER
    VALUE: 60

DEFINE:
    ID: constant.minutes_per_week
    KIND: kind.constant
    TYPE: INTEGER
    VALUE: REF(constant.days_per_week) * REF(constant.hours_per_day) * REF(constant.minutes_per_hour)
