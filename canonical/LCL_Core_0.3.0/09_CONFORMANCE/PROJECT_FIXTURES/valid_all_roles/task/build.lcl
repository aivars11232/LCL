LCL:
    VERSION: "0.3.0"

SPECIFICATION:
    ID: fixture.build
    NAME: "Build"
    VERSION: "1.0.0"
    KIND: kind.part.task

GOAL:
    ID: goal.double
    ASSERT: REF(output.value) == 8

ACTION:
    ID: action.calculate
    OPERATION: core.calculate
    TARGET: REF(input.value)
    PARAMETER:
        NAME: expression
        TYPE: STRING
        REQUIRED: TRUE
        VALUE: "REF(input.value) * 2"
    OUTPUT: REF(output.value)

TASK:
    ID: task.double
    GOAL: REF(goal.double)
    INPUT: REF(input.value)
    ACTION: REF(action.calculate)
    OUTPUT: REF(output.value)
    SUCCESS: REF(success.double)
