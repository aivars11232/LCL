  "result_schemas": {
    "result.value": {
      "fields": {
        "value": "meta.material_value",
        "status": "qualified_identifier(status)",
        "evidence": "LIST[REFERENCE[EVIDENCE]]"
      }
    },
    "result.collection": {
      "fields": {
        "items": "LIST[T]",
        "count": "INTEGER",
        "status": "qualified_identifier(status)"
      }
    },
    "result.operation": {
      "fields": {
        "status": "qualified_identifier(status)",
        "changed": "BOOLEAN",
        "target": "target_expression",
        "error": "qualified_identifier(error)|NULL"
      }
    },
    "result.command": {
      "fields": {
        "exit_code": "INTEGER",
        "stdout": "STRING",
        "stderr": "STRING",
        "status": "qualified_identifier(status)"
      }
    },
    "result.validation": {
      "fields": {
        "valid": "BOOLEAN",
        "errors": "LIST[qualified_identifier(error)]",
        "status": "qualified_identifier(status)"
      }
    },
    "result.verification": {
      "fields": {
        "verified": "BOOLEAN|UNKNOWN",
        "observed": "OBJECT",
        "errors": "LIST[qualified_identifier(error)]"
      }
    },
    "result.test": {
      "fields": {
        "passed": "BOOLEAN|UNKNOWN",
        "expected": "meta.material_value|NULL",
        "actual": "meta.material_value|NULL",
        "evidence": "LIST[REFERENCE[EVIDENCE]]"
      }
    },
    "result.message": {
      "fields": {
        "delivered": "BOOLEAN|UNKNOWN",
        "recipient": "target_expression",
        "message_id": "STRING|NULL",
        "status": "qualified_identifier(status)"
      }
    },
    "result.transfer": {
      "fields": {
        "source": "source_expression",
        "destination": "target_expression",
        "bytes": "BYTES|UNKNOWN",
        "checksum": "STRING|NULL",
        "status": "qualified_identifier(status)"
      }
    }
