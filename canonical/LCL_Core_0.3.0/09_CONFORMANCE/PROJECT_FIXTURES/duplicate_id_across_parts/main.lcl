LCL:
    VERSION: "0.3.0"

SPECIFICATION:
    ID: fixture.project
    NAME: "Duplicate ID across parts"
    VERSION: "1.0.0"
    KIND: kind.project

PART:
    ID: part.output
    SOURCE: PATH("output.lcl")
    KIND: kind.part.output

PART:
    ID: part.task
    SOURCE: PATH("task.lcl")
    KIND: kind.part.task

EXECUTE:
    REFERENCE: REF(task.double)
