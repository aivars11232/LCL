LCL:
    VERSION: "0.3.0"

SPECIFICATION:
    ID: fixture.project
    NAME: "Import cycle"
    VERSION: "1.0.0"
    KIND: kind.project

PART:
    ID: part.task
    SOURCE: PATH("task.lcl")
    KIND: kind.part.task

IMPORT:
    ID: import.a
    SOURCE: PATH("lib_a.lcl")
    NAMESPACE: liba
    VERSION: "1.0.0"

EXECUTE:
    REFERENCE: REF(task.double)
