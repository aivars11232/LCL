LCL:
    VERSION: "0.3.0"

SPECIFICATION:
    ID: fixture.project
    NAME: "Optional part absent"
    VERSION: "1.0.0"
    KIND: kind.project

PART:
    ID: part.notes
    SOURCE: PATH("description.lcl")
    KIND: kind.part.description
    REQUIRED: FALSE

PART:
    ID: part.task
    SOURCE: PATH("task.lcl")
    KIND: kind.part.task

EXECUTE:
    REFERENCE: REF(task.double)
