LCL:
    VERSION: "0.3.0"

SPECIFICATION:
    ID: fixture.project
    NAME: "Cross-part reference cycle"
    VERSION: "1.0.0"
    KIND: kind.project

PART:
    ID: part.defs_a
    SOURCE: PATH("defs_a.lcl")
    KIND: kind.part.definitions

PART:
    ID: part.defs_b
    SOURCE: PATH("defs_b.lcl")
    KIND: kind.part.definitions

PART:
    ID: part.task
    SOURCE: PATH("task.lcl")
    KIND: kind.part.task

EXECUTE:
    REFERENCE: REF(task.double)
