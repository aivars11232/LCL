<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared MIME info for LCL documents.

  This file teaches a desktop to recognize a `.lcl` file. It changes no
  language rule and cannot: LCL Core 0.1.0 registers `format.lcl` as "A
  document conforming to an exact LCL version" and says nothing about file
  names, extensions or media types. A document's meaning comes from its bytes
  and the version it declares, never from where it is stored or what it is
  called.

  The magic rule is grounded rather than guessed. `04_GRAMMAR/01` requires that
  "Every document starts with LCL then SPECIFICATION", and `02_LEXICAL/01`
  requires UTF-8 with no byte-order mark, so a document's first four bytes are
  exactly `LCL:`. The one exception is an LCL 0.2.0 document that opens with
  its locale directive, which LCL Core 0.2.0 `02_LEXICAL/13` defines as
  "@locale, one SPACE, one locale tag and LINE FEED at byte offset zero". The
  two matches below are alternatives, so either start is recognised.

  Install with ./install.sh, which writes only into the invoking user's own
  ~/.local/share. Nothing here is installed by building the workspace.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-lcl">
    <comment>LCL document</comment>
    <comment xml:lang="en">Learned Computing Language document</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.lcl"/>
    <!--
      New documents are created as `*.lcl.txt`, so that a document can be
      shared and edited anywhere plain text is. The two-part pattern is longer
      than `*.txt`, and the specification resolves overlapping globs by the
      longest match, so an `.lcl.txt` file is recognised as an LCL document
      while every other `.txt` file stays exactly what it was. No pattern for
      `*.txt` is declared here, and `text/plain` is not modified.
    -->
    <glob pattern="*.lcl.txt"/>
    <magic priority="50">
      <match type="string" value="LCL:" offset="0"/>
      <match type="string" value="@locale " offset="0"/>
    </magic>
  </mime-type>
</mime-info>
