LCL:
    VERSION: "0.1.0"

SPECIFICATION:
    ID: app.release_pipeline_decomposed
    NAME: "Release pipeline, decomposed"
    VERSION: "1.0.0"
    KIND: kind.task
    DOMAIN: "release"
    AUTHORITY: 600

IMPORT:
    ID: import.types
    SOURCE: PATH("types.lcl")
    NAMESPACE: release_types
    VERSION: "1.0.0"
    AUTHORITY: 600
    REQUIRED: TRUE

IMPORT:
    ID: import.rules
    SOURCE: PATH("rules.lcl")
    NAMESPACE: release_rules
    VERSION: "1.0.0"
    AUTHORITY: 600
    REQUIRED: TRUE

WORKSPACE:
    ID: workspace.release
    PATH: PATH("/tmp/lcl-apps/large-release-pipeline-decomposed")
    MODE: mode.read_write

SCOPE:
    ID: scope.task
    INCLUDE: REF(task.release)

DATA:
    ID: data.artifact
    TYPE: OBJECT[REF(release_types.type.artifact)]
    VALUE:
        name: "lcl"
        bytes: 4

CONTEXT:
    ID: context.channel
    TYPE: OBJECT[REF(release_types.type.channel)]
    SCOPE: REF(scope.task)
    VALUE:
        name: "stable"
        notify: TRUE

STATE:
    ID: state.expected_bytes
    TYPE: INTEGER
    SCOPE: REF(scope.task)
    MODE: mode.read_only
    VALUE: 4

HANDLER:
    ID: handler.host
    EVENT: event.host_constraint
    OPERATION: core.retry
    FALLBACK: core.stop
    LIMIT: 2

OUTPUT:
    ID: output.manifest
    TYPE: PATH
    FORMAT: format.plain_text
    TARGET: PATH(REF(workspace.release), "MANIFEST.txt")
    PROPERTY: target

OUTPUT:
    ID: output.head
    TYPE: STRING
    FORMAT: format.plain_text

OUTPUT:
    ID: output.name
    TYPE: STRING
    FORMAT: format.plain_text

ACTION:
    ID: action.write_manifest
    OPERATION: core.create
    TARGET: PATH(REF(workspace.release), "MANIFEST.txt")
    PARAMETER:
        NAME: content
        TYPE: STRING
        REQUIRED: TRUE
        VALUE: "lcl 0.1.0"
    OUTPUT: REF(output.manifest)
    RETRY:
        LIMIT: 2
        WHEN: REF(output.manifest) == MISSING
        DELAY: DURATION(1, unit.second)
        HANDLER: REF(handler.host)

ACTION:
    ID: action.read_head
    OPERATION: core.read
    TARGET: PATH(REF(workspace.release), "MANIFEST.txt")
    PARAMETER:
        NAME: range
        TYPE: OBJECT
        REQUIRED: TRUE
        VALUE:
            unit: "scalar"
            start: 0
            end: 3
    OUTPUT: REF(output.head)

ACTION:
    ID: action.name
    OPERATION: core.calculate
    TARGET: REF(data.artifact)
    PARAMETER:
        NAME: expression
        TYPE: STRING
        REQUIRED: TRUE
        VALUE: "REF(data.artifact).name"
    OUTPUT: REF(output.name)

GOAL:
    ID: goal.prepare
    ASSERT: EXISTS(REF(output.manifest))

VERIFY:
    ID: verify.manifest
    REQUIRED: TRUE
    ASSERT: EXISTS(REF(output.manifest))
    EVIDENCE: REF(evidence.channel)

EVIDENCE:
    ID: evidence.channel
    TYPE: STRING
    VALUE: "Published to the stable channel declared in CONTEXT context.channel."
    PROVENANCE: "Declared directly in this specification."
    REQUIRED: TRUE

SUCCESS:
    ID: success.prepare
    ALL: [REF(verify.manifest)]

TASK:
    ID: task.prepare
    GOAL: REF(goal.prepare)
    ACTION: REF(action.write_manifest)
    OUTPUT: REF(output.manifest)
    HANDLER: REF(handler.host)
    SUCCESS: REF(success.prepare)

GOAL:
    ID: goal.inspect
    ASSERT: REF(output.head) == "lcl"

VERIFY:
    ID: verify.head
    REQUIRED: TRUE
    ASSERT: REF(output.head) == "lcl"

VERIFY:
    ID: verify.name
    REQUIRED: TRUE
    ASSERT: REF(output.name) == "lcl"

SUCCESS:
    ID: success.inspect
    ALL: [REF(verify.head), REF(verify.name)]

TASK:
    ID: task.inspect
    GOAL: REF(goal.inspect)
    ACTION: [REF(action.read_head), REF(action.name)]
    OUTPUT: [REF(output.head), REF(output.name)]
    SUCCESS: REF(success.inspect)

PHASE:
    ID: phase.pipeline
    MODE: mode.sequential
    STEP:
        ID: step.prepare
        TASK: REF(task.prepare)
    STEP:
        ID: step.inspect
        TASK: REF(task.inspect)

GOAL:
    ID: goal.release
    ASSERT: EXISTS(REF(output.manifest))

VERIFY:
    ID: verify.bytes
    REQUIRED: TRUE
    ASSERT: REF(data.artifact).bytes == REF(state.expected_bytes)

VERIFY:
    ID: verify.channel
    REQUIRED: TRUE
    ASSERT: REF(context.channel).name == "stable"

SUCCESS:
    ID: success.release
    ALL: [REF(verify.manifest), REF(verify.head), REF(verify.name), REF(verify.bytes), REF(verify.channel)]

TASK:
    ID: task.release
    GOAL: REF(goal.release)
    WORKSPACE: REF(workspace.release)
    PHASE: REF(phase.pipeline)
    OUTPUT: [REF(output.manifest), REF(output.head), REF(output.name)]
    HANDLER: REF(handler.host)
    SUCCESS: REF(success.release)

EXECUTE:
    REFERENCE: REF(task.release)
