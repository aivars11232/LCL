LCL:
    VERSION: "0.1.0"

SPECIFICATION:
    ID: example.file_rules
    NAME: "File rules library"
    VERSION: "1.0.0"
    KIND: kind.library
    AUTHORITY: 400

SCOPE:
    ID: scope.files
    INCLUDE: GLOB("**")

FORBID:
    ID: rule.no_delete
    OPERATION: core.delete
    TARGET: REF(scope.files)
    AUTHORITY: 400
    PRIORITY: 100
